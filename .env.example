# Base de données Neon (Postgres). Sur Netlify, l'intégration Neon fournit NETLIFY_DATABASE_URL ;
# l'application accepte l'une ou l'autre variable.
DATABASE_URL=
NETLIFY_DATABASE_URL=

# Secret de signature des sessions (32 caractères minimum, aléatoire).
NP_SESSION_SECRET=

# Origine publique exacte du site (CORS / cookies), ex. https://nuagespolaires.netlify.app
NP_SITE_URL=

# Récupération contrôlée d'un accès admin (temporaire, à retirer après usage).
NP_ADMIN_PSEUDO=
NP_ADMIN_PASSWORD=
NP_ADMIN_RECOVERY=

# Connexion par Discord (optionnelle : laisser vide pour désactiver).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Webhook Discord pour les annonces d'événements (optionnel).
DISCORD_EVENTS_WEBHOOK_URL=
